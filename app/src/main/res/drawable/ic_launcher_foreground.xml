<?xml version="1.0" encoding="utf-8"?>
<!--
  A barra sobre o ₿ é a notação de média (o traço de x̄): é ela que diz que o
  app mede um preço médio, e não que ele é mais uma carteira. Nos tamanhos
  pequenos do launcher o ₿ sozinho vira borrão; a barra sobrevive.

  O desenho cabe no círculo de 66dp — e não apenas no quadrado de 72dp da zona
  segura. A máscara circular do launcher corta os cantos do quadrado, e era
  exatamente ali que as pontas da barra estavam. Com centro em (54,54) e raio
  33, o ponto mais exposto é o canto da barra: 19² + 25² = 986, raio 31,4.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A barra da média: cápsula de 38x6, pontas totalmente arredondadas. -->
    <path
        android:fillColor="#E2873A"
        android:pathData="M38,29 H70 A3,3 0 0 1 70,35 H38 A3,3 0 0 1 38,29 Z" />

    <!--
      O ₿ é desenhado no seu tamanho natural (39x64, centrado em 57,5/54) e o
      grupo o reduz e reposiciona. Assim os traçados abaixo continuam legíveis
      em números redondos em vez de virarem decimais recalculados à mão.
    -->
    <group
        android:pivotX="57.5"
        android:pivotY="54"
        android:scaleX="0.59375"
        android:scaleY="0.59375"
        android:translateX="-3.5"
        android:translateY="6">

        <!-- Corpo do B, com os dois vazados internos como buracos reais. -->
        <path
            android:fillColor="#FAF7F2"
            android:fillType="evenOdd"
            android:pathData="M38,30 H62 A12,12 0 0 1 62,54 H38 Z
                              M48,38 H60 A4,4 0 0 1 60,46 H48 Z
                              M38,54 H65 A12,12 0 0 1 65,78 H38 Z
                              M48,62 H62 A4,4 0 0 1 62,70 H48 Z" />

        <!-- Os quatro traços verticais que distinguem o ₿ de um B comum. -->
        <path
            android:fillColor="#FAF7F2"
            android:pathData="M44,22 h6 v10 h-6 z
                              M56,22 h6 v10 h-6 z
                              M44,76 h6 v10 h-6 z
                              M56,76 h6 v10 h-6 z" />
    </group>
</vector>
