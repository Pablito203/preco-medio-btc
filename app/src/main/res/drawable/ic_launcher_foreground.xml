<?xml version="1.0" encoding="utf-8"?>
<!--
  O símbolo ₿ desenhado em vetor: dispensa PNGs em várias densidades e mantém
  o APK pequeno. Todo o traçado fica dentro da zona segura de 72dp do ícone
  adaptativo (coordenadas 18 a 90 no viewport de 108).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Corpo do B, com os dois vazados internos como buracos reais. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M38,30 H62 A12,12 0 0 1 62,54 H38 Z
                          M48,38 H60 A4,4 0 0 1 60,46 H48 Z
                          M38,54 H65 A12,12 0 0 1 65,78 H38 Z
                          M48,62 H62 A4,4 0 0 1 62,70 H48 Z" />

    <!-- Os quatro traços verticais que distinguem o ₿ de um B comum. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,22 h6 v10 h-6 z
                          M56,22 h6 v10 h-6 z
                          M44,76 h6 v10 h-6 z
                          M56,76 h6 v10 h-6 z" />
</vector>
